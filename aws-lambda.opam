# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "AWS Lambda Runtime API (2018-06-01) custom-runtime loop, I/O-agnostic"
description: """
The AWS Lambda Runtime API loop used by custom runtimes (next invocation,
response, error). The HTTP round trip is an OCaml 5 effect handled by the
caller or by an adapter such as aws-lambda-eio; the core performs no I/O. No
runtime dependencies beyond the OCaml standard library."""
maintainer: ["Yuki Tajiri"]
authors: ["Yuki Tajiri"]
license: "MIT"
homepage: "https://github.com/lmdexpr/aws-lambda.ml"
bug-reports: "https://github.com/lmdexpr/aws-lambda.ml/issues"
depends: [
  "ocaml" {>= "5.3.0"}
  "dune" {>= "3.23"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/lmdexpr/aws-lambda.ml.git"
x-maintenance-intent: ["(latest)"]
