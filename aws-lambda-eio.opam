# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Cohttp-eio transport for aws-lambda"
description: """
Handles the aws-lambda transport effect with a cohttp-eio client. Kept
separate from the core aws-lambda package so that callers that bring their own
HTTP client do not pull in eio and cohttp."""
maintainer: ["Yuki Tajiri"]
authors: ["Yuki Tajiri"]
license: "MIT"
homepage: "https://github.com/lmdexpr/aws-lambda.ml"
bug-reports: "https://github.com/lmdexpr/aws-lambda.ml/issues"
depends: [
  "ocaml" {>= "5.3.0"}
  "dune" {>= "3.23"}
  "aws-lambda" {= version}
  "eio"
  "cohttp-eio"
  "http"
  "uri"
  "alcotest" {with-test}
  "eio_main" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/lmdexpr/aws-lambda.ml.git"
x-maintenance-intent: ["(latest)"]
